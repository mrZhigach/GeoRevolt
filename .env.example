# GeoRevolt – Deployment Configuration
# Copy to .env and fill in your values

# === Required ===
PRIVATE_KEY=0x

# === Network ===
AMOY_RPC_URL=https://rpc-amoy.polygon.technology/
DEPLOY_NETWORK=polygon-amoy

# === Contracts ===
# Amoy USDC (Circle-bridged): leave empty to deploy a MockUSDC instead
USDC_ADDRESS=0xd02419296eF08A575E6deA178950e9c9c25126B8

# Fee treasury address (defaults to deployer if empty)
FEE_TO=

# === Test Market ===
CREATE_TEST_MARKET=true

# === Frontend (Next.js) ===
NEXT_PUBLIC_MARKET_FACTORY_ADDRESS=0x34A1D3fff3958843C43aD80F30b94c510645C316
NEXT_PUBLIC_MOCK_USDC_ADDRESS=0x5b73C5498c1E3b4dbA84de0F1833c4a029d90519

# === Database ===
# DATABASE_URL=postgresql://georevolt:georevolt@localhost:5432/georevolt
# DB_PATH=./data/georevolt.db

# === Docker ===
# COMPOSE_PROFILES=dev

# === E2E Fork ===
# AMOY_RPC_URL=https://rpc-amoy.polygon.technology/
